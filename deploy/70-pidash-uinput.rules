# udev rule: /etc/udev/rules.d/70-pidash-uinput.rules
# Installed only by `install.sh --phone-input`.
#
# Lets members of the "input" group create virtual input devices, which is how
# the PiDash phone remote acts as a mouse and keyboard. On Raspberry Pi OS the
# first user is in that group already.
KERNEL=="uinput", SUBSYSTEM=="misc", GROUP="input", MODE="0660", OPTIONS+="static_node=uinput"
