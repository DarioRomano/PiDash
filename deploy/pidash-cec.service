[Unit]
Description=PiDash HDMI-CEC setup (register as playback device so the TV forwards remote keys)
After=pidash-kiosk.service
Wants=pidash-kiosk.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/pidash/cec-setup.sh
# Retry a few times: the TV may take a moment to enumerate HDMI after boot.
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=120
StartLimitBurst=10

[Install]
WantedBy=graphical.target
