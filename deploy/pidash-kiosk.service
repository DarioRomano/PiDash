[Unit]
Description=PiDash kiosk (cage + Chromium on tty1)
After=systemd-user-sessions.service pidash.service plymouth-quit-wait.service
Wants=pidash.service
Conflicts=getty@tty1.service
ConditionPathExists=/dev/tty1

[Service]
Type=simple
User=@USER@
# PAMName=login makes logind create a seat session for us, which gives cage
# access to the GPU and input devices without running as root.
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=PIDASH_URL=http://127.0.0.1:8080/
# Wait for the backend before launching the browser so it never shows an error page.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 60); do curl -fs http://127.0.0.1:8080/healthz >/dev/null && exit 0; sleep 1; done; exit 1'
ExecStart=/opt/pidash/kiosk.sh
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
